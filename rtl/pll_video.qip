set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) "pll_video.v"]
set_instance_assignment -name PLL_COMPENSATION_MODE DIRECT -to "*pll_video*|altera_pll:altera_pll_i*|*"
set_instance_assignment -name PLL_AUTO_RESET OFF -to "*pll_video*|altera_pll:altera_pll_i*|*"
set_instance_assignment -name PLL_BANDWIDTH_PRESET AUTO -to "*pll_video*|altera_pll:altera_pll_i*|*"
